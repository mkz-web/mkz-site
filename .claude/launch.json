{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mkz-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "mkz-wrangler",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["wrangler", "pages", "dev", "out", "--port", "8788"],
      "port": 8788
    },
    {
      "name": "mkz-assistant",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["wrangler", "pages", "dev", "out", "--port", "8789", "--binding", "ANTHROPIC_API_KEY=cle-factice-locale"],
      "port": 8789
    },
    {
      "name": "mkz-out",
      "runtimeExecutable": "py",
      "runtimeArgs": ["-m", "http.server", "8787", "-d", "out"],
      "port": 8787
    }
  ]
}
